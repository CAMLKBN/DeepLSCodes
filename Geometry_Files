def compute_unit_outward_normal(points, circle_type):
    r_vec = points / (torch.norm(points, dim=1, keepdim=True) + 1e-8)
    if circle_type == "OuterCircle":
        #r = r_outer
        #---------------------------------------------;
        # Outward normal for outer circle: (x/r, y/r) ;
        #---------------------------------------------;
        normals = r_vec#points / r
    elif circle_type == "InnerCircle":
        #r = r_inner
        #---------------------------------;
        # Outward normal for inner circle ;
        #---------------------------------;
        normals = -(-r_vec)#-points / r
    else:
        raise ValueError("circle_type must be 'OuterCircle' or 'InnerCircle'.")
    #--------------------;
    # Ensure unit length ;
    #--------------------;
    #normals /= torch.norm(normals, dim=1, keepdim=True) + 1e-8
    return normals

