#------------------------------------;
# Function to sample boundary points ;
#------------------------------------;

def sample_boundary_points(N_boundary, circle_type):
    theta = np.linspace(0, 2 * np.pi, N_boundary, endpoint=False)
    if circle_type == "OuterCircle":
        r = r_outer
    elif circle_type == "InnerCircle":
        r = r_inner
    else:
        raise ValueError("circle_type must be 'OuterCircle' or 'InnerCircle'.")

    x = r * np.cos(theta)
    y = r * np.sin(theta)
    points = np.stack([x, y], axis=1)
    return torch.tensor(points, dtype=torch.float32)

#==================================;
# Function to sample domain points ;
#==================================;

def sample_domain_points(N_domain):
    #------------------------------;
    # Oversample in a bounding box ;
    #------------------------------;
    points = np.random.uniform(-r_outer, r_outer, (N_domain * 2, 2))

    valid_points = []
    for p in points:
        r = np.sqrt(p[0]**2 + p[1]**2)
        if r_inner <= r <= r_outer:
            valid_points.append(p)

    valid_points = valid_points[:N_domain]
    if len(valid_points) < N_domain:
        print(f"Warning: Only {len(valid_points)} domain points sampled.")

    return torch.tensor(valid_points, dtype=torch.float32)
